#!/usr/bin/env python3
"""lookout — the supervisor's single command (docs/plan.md 3.7). On the Bash PATH via the plugin's bin/.

One entry point so one allow rule (`Bash(lookout *)`) covers every supervisor step.
Subcommands (PROYECTO = a path inside the repo, or its project_id):
  quien                         identity of this session (session_id, pid, SendMessage address, pane)
  inicia PROYECTO [--nombre N]  check herdr (version, client vs server; exit 6 = refused, nothing taken) and goalspec
                                (absent = warning), take the project lock, discover and register its agents
  entrega PROYECTO AGENTE [--pasos reload,rename,nota]
                                deliver to a quiet agent (idle, or working only by a background shell) with an
                                empty input box, in order:
                                /reload-plugins (V1), /rename + herdr renames (V12), the report note
  nota PROYECTO AGENTE          print the report note for one agent
  resumen PROYECTO [--no-marcar] [--todo]  agents table + events not handled yet (≤40 lines; --todo = all); advances
                                the cursor, rewrites supervisor.md, and says the supervisor's context against its budget
  retomar PROYECTO              rewrite supervisor.md and print its «Como retomar» (relief of the supervisor, Fase 4)
  espera PROYECTO               the single waiter: run it with run_in_background, as the LAST step of a turn
  suelta PROYECTO               release the lock, remove the agents' markers, stop the waiter
  pendientes PROYECTO [--tope N] [--rehacer] [--worktree ID..] [--en-main ID..]  (worktree solo si el usuario lo pide)
                                propose a batch from memory/_pendientes.md (F2): batch, queue, excluded,
                                and one task prompt per batch item in the state folder
  pendientes PROYECTO --match T [T...]  open pendientes that mention these terms (H13)
  lanza PROYECTO ID [ID...] [--modelo M]  launch approved batch items: a tab on the main checkout (or the worktree the user asked for) + agent + its task, once
  libera PROYECTO AGENTE --fuera ninguno|TEXTO [--usuario-confirmo D] [--fallida]
                                        the agent's task is done (or failed): free its slot, propose again
  envia PROYECTO AGENTE (--tarea | --clave K --texto T)
                                idempotent delivery (bin/deliver.py); --tarea = the agent's task trigger again
  gobierno PROYECTO AGENTE [--para push|ronda] [--usuario-amplia N --decision ID]
                                goalspec governance (F3): may this agent's push go to the user? may it open one
                                more adversary round? (from its own transcript; exit 5 = no)
  publica PROYECTO AGENTE [--worktree RUTA] [--decision ID] [--hecho [--pr N] | --retira]   publications in order
                                (H14): verify and queue; --worktree when the agent works in a worktree its registry
                                entry does not name; --decision: the user's yes to a --sin-revisor decision (0.13.41);
                                in PR mode --hecho takes the number of the PR the agent opened, and with no lista
                                publication it queues a PR opened outside lookout, unverified, if its branch is the
                                one of the agent's tree (--worktree or the registry's) (0.13.41)
  publica PROYECTO --cola       the publication queue
  publica PROYECTO --modo pr|directo  how this project publishes (0.13.27): pushes to main (directo, the default) or
                                a branch + pull request per agent that the user merges (pr)
  publica PROYECTO --fusiona N --decision ID [--fuera-de-orden]  merge open PR N of the queue (merge commit) on the
                                user's yes in your modal: verified head, mergeable, checks green, first in merge order
  regla-push PROYECTO [--estado]  the temporary push rule the USER applies (H15); --estado reads whether it is on
  permisos                      the executors' permission rules (D6, F5): active or not, where the user activates them
  cierra PROYECTO AGENTE [--estado resolved|superseded|abandoned] --nota N --usuario-confirmo DECISION_ID [--sin-push RAZON]
  descarta PROYECTO P-ID [--estado abandoned|superseded] --nota N --usuario-confirmo DECISION_ID
                                close by journal a pendiente that never had an agent (Fase 9 C1)
                                close the agent's pendiente by journal (pendiente.resolve), never by editing
  relevo PROYECTO AGENTE [--retomar ARCHIVO] [--modelo M] [--shells D] [--goalspec]
                                /exit + a new session on the same task with its "Como retomar" (F3); --shells: the
                                user's choice for its live background work (0.13.10)
  retoma PROYECTO AGENTE        claude --resume of an agent whose session ended without anyone asking (SessionEnd
                                «other», e.g. a stray kill), in its pane or a new tab on its folder (0.13.20)
  decision PROYECTO (--abre TEXTO [--agentes A,B] [--si-es ETIQUETA] [--cierre] [--shells-parar E --shells-dejar E]
                    [--permiso | --sin-revisor | --negado [--siempre-es ETIQUETA]]
                    | --cierra ID --respuesta R (--si|--no) | --lista)
                                the user's pending decisions (T4): shown in `resumen` with their age; with --si-es
                                the modal's hook closes it from the user's own choice (0.13.9); with --shells-parar
                                and --shells-dejar it writes down which of the two the user chose (0.13.10); with
                                --permiso it is tied to the agent's pending permission request (0.13.12); with
                                --sin-revisor it is the user's yes to publishing one agent without another adversary
                                round, no verdict or a break with unsafe=0, tied to that verdict line (0.13.41)
  aprueba PROYECTO AGENTE --decision ID
                                press «Yes» once in the agent's permission dialog after the user's yes in your modal,
                                only if the dialog on screen shows exactly the command the user approved (0.13.12)
  corrige PROYECTO AGENTE --resumen R [--firma F] [--reporte CITA]
                                record a correction for the agent's repeated error (Fase 6) and print the message to
                                send it; after 2 corrections of the same error: PARA (exit 5), escalate instead
  puerto PROYECTO AGENTE        the agent's dev-server port (Fase 6; launched agents already have $PORT)
"""
import argparse
import json
import os
import re
import shlex
import signal
import sys
import time

HERE = os.path.dirname(os.path.abspath(__file__))
sys.path.insert(0, HERE)
import alta  # noqa: E402
import aprueba  # noqa: E402
import cierre  # noqa: E402
import decisiones  # noqa: E402
import deliver  # noqa: E402
import digest  # noqa: E402
import discover  # noqa: E402
import gobierno  # noqa: E402
import herdr_cli  # noqa: E402
import inputbox  # noqa: E402
import lock  # noqa: E402
import lookout_state  # noqa: E402
import lote  # noqa: E402
import modo  # noqa: E402
import pendientes  # noqa: E402
import permisos  # noqa: E402
import publica  # noqa: E402
import registry  # noqa: E402
import supervisor_md  # noqa: E402
import teclea  # noqa: E402
import relevo  # noqa: E402
import requisitos  # noqa: E402
import retiro  # noqa: E402
import retomar  # noqa: E402
import retoma  # noqa: E402
import sesiones  # noqa: E402

NOTA = os.path.join(HERE, "..", "skills", "supervisa", "references", "nota-reporte.md")
WAITER_TIMEOUT = 7000  # s; under the 7200 s ceiling of a background Bash task


def project(arg):
    pid, common = discover.resolve_project(arg)
    if not pid:
        sys.exit("no encuentro el proyecto %r (ni repo git ni project_id con candado)" % arg)
    return pid, common


def cmd_quien(_a):
    print(json.dumps(lock.me(), ensure_ascii=False, indent=1))


def cmd_inicia(a):
    pid, common = project(a.proyecto)
    me = lock.me(a.nombre or "supervisor-" + os.path.basename(os.path.dirname(common.rstrip("/"))))
    if not me["session_id"] or not me["address"]:
        sys.exit("faltan CLAUDE_CODE_SESSION_ID o CLAUDE_CODE_MESSAGING_SOCKET: corre esto desde una sesión de Claude Code")
    roots = lookout_state.worktree_roots(os.path.dirname(common.rstrip("/")) if common.endswith("/.git") else a.proyecto)
    if not roots:
        roots = lookout_state.worktree_roots(a.proyecto)
    ok, problems, notes = requisitos.check_herdr()  # Fase 7: before the lock, so a refusal leaves nothing behind
    for n in notes:
        print("Nota: " + n)
    if not ok:
        print("NO ARRANCO: " + " ".join(problems))
        print("No tomé el candado ni toqué a ningún agente. Díselo al usuario.")
        return 6
    if not requisitos.goalspec_instalado(roots[0] if roots else os.path.realpath(a.proyecto)):
        print(requisitos.AVISO_GOALSPEC)
    status, data = lock.acquire(pid, common, roots, me)
    if status == "ocupado":
        owner = data.get("supervisor") or {}
        print("CANDADO OCUPADO: el proyecto %s ya lo supervisa '%s' (pane %s, sesión %s, dirección %s, desde %s)."
              % (pid, owner.get("nombre"), owner.get("pane"), owner.get("session_id"), owner.get("address"), data.get("desde")))
        print("No tomes nada. Díselo al usuario.")
        return 3
    relevo_sup = status in ("tomado-de-muerto", "relevo-mismo-proceso")
    if status == "tomado-de-muerto":
        prev = data.get("anterior") or {}
        print("Candado tomado: su dueño anterior '%s' (sesión %s) ya no vive." % (prev.get("nombre"), prev.get("session_id")))
    elif status == "relevo-mismo-proceso":
        prev = data.get("anterior") or {}
        print("Candado tomado: era de este mismo proceso con otra sesión (%s; /clear). Eres su relevo." % prev.get("session_id"))
    else:
        print("Candado: %s." % ("nuevo" if status == "nuevo" else "ya era tuyo"))
    if relevo_sup:
        supervisor_md.unmark_supervisor((data.get("anterior") or {}).get("session_id", ""))
    supervisor_md.mark_supervisor(me["session_id"], pid)
    lock.set_contexto_inicial(pid, me["session_id"], digest.context_tokens(me["session_id"]))
    todos = herdr_cli.agent_list()
    cola_antes = {x["session_id"] for x in registry.load(pid).get("espera_cupo") or []}  # 0.13.36
    found = alta.filtra_cupo(pid, discover.discover(common, todos), todos, me)  # 0.13.34
    mine = {f.get("session_id") for f in found}
    ajenos = {t.get("name") for t in todos if (t.get("agent_session") or {}).get("value") not in mine}
    reg = registry.register(pid, me, found, ajenos, todos)
    retomar.al_registrar(pid, [f.get("session_id") for f in found if f.get("session_id")])  # 0.13.0
    modos = modo.empata(pid, [f for f in found if f.get("kind") == "claude" and f.get("session_id")])  # 0.13.33
    others = [f for f in found if f.get("kind") != "claude" or not f.get("session_id")]
    for x in publica.concilia(pid):  # Fase 9 E3
        print(x)
    print("Proyecto %s (%s). Raíces: %s" % (pid, common, ", ".join(roots)))
    cola = registry.load(pid).get("espera_cupo") or []
    if cola:  # 0.13.34
        # 0.13.36: a new one in the queue gets its `cupo de N lleno` line in the next resumen (adversary r1); one queued
        # before this inicia had it under the previous supervisor, maybe never sent: it is asked here (codex r4)
        print("CUPO: %d lleno. Esperan turno, sin registrar: %s. El waiter los registra cuando se libere un hueco."
              % (registry.cupo(), ", ".join(x.get("pestana") or x.get("pane_id") or x["session_id"][:8] for x in cola)))
        nuevos_cola = [x for x in cola if x["session_id"] not in cola_antes]
        viejos_cola = [x for x in cola if x["session_id"] in cola_antes]
        if nuevos_cola:
            print("  Los nuevos en la cola salen en el próximo `resumen` con su línea `cupo de %d lleno`: manda desde "
                  "ahí «Espera tu turno»." % registry.cupo())
        for x in viejos_cola:
            print("  Ya esperaba antes de este inicia: %s (%s). Mándale «Espera tu turno» por SendMessage (texto en la "
                  "skill); sin to, pregúntale al usuario si lo para él." % (
                      x.get("pestana") or x.get("pane_id") or x["session_id"][:8], sesiones.to_texto(x)))
    print("Supervisor: %s → %s" % (me["nombre"], me["address"]))
    print(nombra_supervisor(me))
    print("")
    print("Al usuario nombra a cada agente por su pestaña de herdr (columna `pestaña`): es lo que él ve. El pane "
          "(wS:p25) no le dice nada.")
    # 0.13.24 (p-e9c8601cfb): the session's own name, which SendMessage takes; lookout's name may not be it
    print("Para SendMessage usa la columna `to`: es el nombre de su sesión, que puede no ser el de lookout.")
    print("nombre | pestaña | worktree | rama | estado herdr | session | to (SendMessage)")
    for e in reg["agents"].values():
        if e.get("retirado"):
            continue  # Fase 9 E2: its pane is another session's now
        print("%s | %s | %s | %s | %s | %s | %s" % (e["nombre"], e.get("pestana") or "-", e.get("worktree") or "-",
                                                  e.get("branch") or "-", e.get("estado_herdr") or "-",
                                                  e["session_id"][:8], sesiones.to_texto(e)))
        if modos.get(e["session_id"]):
            print("  %s %s" % (e["nombre"], modo.describe(modos[e["session_id"]])))
    for o in others:
        print("(no registrado: pestaña %s en %s, kind=%s, sin session_id de Claude)" % (
            o.get("pestana") or o["pane_id"], o["cwd"], o["kind"]))
    print("")
    md = supervisor_md.write(pid)
    if relevo_sup:
        live = {f.get("session_id") for f in found}
        avisar = ["%s (%s)" % (e["nombre"], sesiones.to_texto(e)) for s, e in reg["agents"].items()
                  if s in live and e.get("hooks") == "ok"]
        print("RELEVO DEL SUPERVISOR. Tu estado: %s (léelo antes de decidir nada: decisiones tomadas y pendientes,"
              " lo que ya respondiste a cada agente)." % md)
        print("Sus notas de reporte llevan la dirección vieja. Manda a cada uno, por SendMessage (to = el de la lista), este texto"
              " tal cual: «Cambio de supervisor: desde ahora tus reportes y preguntas van a to=\"%s\" (cópialo tal cual);"
              " la dirección anterior ya no existe.»" % me["address"])
        print("Avisar a: %s" % (", ".join(avisar) or "nadie (ningún agente vivo con hooks confirmados)"))
        print("No hace falta `lookout entrega`: ya están registrados y con hooks.")
        return 0
    print("Siguiente: `lookout entrega %s <nombre>` para cada agente quieto." % pid)
    return 0


def render_nota(pid, entry):
    lk = lock.read(pid) or {}
    sup = lk.get("supervisor") or {}
    with open(NOTA, encoding="utf-8") as fh:
        text = fh.read().strip()
    text = text.format(supervisor=sup.get("nombre", "supervisor"), address=sup.get("address", ""),
                       nombre=entry["nombre"])
    # One line on purpose: herdr delivers a multi-line prompt as a paste, and Claude Code wraps it in
    # <pasted_content>, whose instructions a model may decline to follow (phase-1 run, 2026-10-02).
    return " ".join(line.strip() for line in text.splitlines() if line.strip())


def cmd_nota(a):
    pid, _ = project(a.proyecto)
    entry = registry.find(registry.load(pid), a.agente)
    if not entry:
        sys.exit("agente %r no registrado" % a.agente)
    print(render_nota(pid, entry))


def box_state(pane):
    code, out, _ = herdr_cli.run(["agent", "read", pane, "--source", "visible", "--format", "ansi"])
    return inputbox.classify(out) if code == 0 else "desconocida"


RENAME_ESPERA = 10  # s at most for the /rename to leave the input box (B2, 0.12.2)
ENTREGA_RELOAD_ESPERA = 15  # s at most for the /reload-plugins row in its transcript (0.13.31; the old wait-output's 15)


def caja_libre(pane, limite, cada=0.3):
    """Wait until the input box reads empty (or a suggestion) twice in a row, `cada` s apart, or `limite` s pass.
    Returns the last state read. Twice: one empty read could come before herdr's typing reaches the screen."""
    fin = time.time() + limite
    seguidas, box = 0, "desconocida"
    while True:
        box = box_state(pane)
        seguidas = seguidas + 1 if box in ("vacia", "sugerencia") else 0
        if seguidas >= 2 or time.time() >= fin:
            return box
        time.sleep(cada)


SUPERVISOR_TAB = "Supervisor"


def nombra_supervisor(me):
    """Name the supervisor's own herdr tab, pane and Claude session, so the user tells it apart at a glance.

    The tab becomes "Supervisor" only when it holds just this pane and nobody named it (a label the user chose
    stays). The session gets `/rename <nombre>` through herdr: herdr accepts a prompt while the session is working
    and Claude Code applies a queued /rename (spike 2026-10-05: custom-title written, terminal title changed); it
    is skipped when the input box has text (the user is typing there) or the session already has that name."""
    pane = me.get("pane") or ""
    if not pane:
        return "Supervisor sin pane de herdr: no renombro pestaña ni sesión."
    live = herdr_cli.agent_get(pane) or {}
    tab = herdr_cli.tab_get(live.get("tab_id", ""))
    hecho = []
    if tab and (tab.get("pane_count") or 1) == 1 and not herdr_cli.own_label(tab):
        if herdr_cli.run(["tab", "rename", live["tab_id"], SUPERVISOR_TAB])[0] == 0:
            hecho.append("pestaña «%s»" % SUPERVISOR_TAB)
    elif tab:
        hecho.append("pestaña «%s» (la dejo: tiene nombre propio o más panes)" % (tab.get("label") or ""))
    herdr_cli.run(["pane", "rename", pane, "lookout: supervisor"])
    nombre = me.get("nombre") or ""
    if nombre and (live.get("terminal_title_stripped") or "") != nombre:
        if box_state(pane) in ("vacia", "sugerencia"):
            herdr_cli.run(["agent", "prompt", pane, "/rename " + nombre])
            hecho.append("sesión «%s» (al terminar este turno)" % nombre)
        else:
            hecho.append("sesión sin renombrar: la caja de entrada tiene texto")
    elif nombre:
        hecho.append("sesión «%s»" % nombre)
    return "Supervisor en herdr: " + (", ".join(hecho) or "sin cambios") + "."


def cmd_entrega(a):
    pid, _ = project(a.proyecto)
    reg = registry.load(pid)
    entry = registry.find(reg, a.agente)
    if not entry:
        sys.exit("agente %r no registrado" % a.agente)
    pane = entry["pane_id"]
    live = herdr_cli.agent_get(pane) or {}
    if (live.get("agent_session") or {}).get("value") != entry["session_id"] or live.get("cwd") != entry["cwd"]:
        print("NO ENTREGADO: el pane %s ya no es de %s (registro viejo). Corre `lookout inicia` otra vez." % (pane, entry["nombre"]))
        return 4
    if not deliver.quieto(pid, entry, live):
        print("NO ENTREGADO: %s está %s. Se le entrega en su siguiente idle." % (entry["nombre"], live.get("agent_status")))
        return 4
    box = box_state(pane)
    if box not in ("vacia", "sugerencia"):
        print("NO ENTREGADO: la caja de entrada de %s tiene %s. No escribo encima; avisa al usuario." % (entry["nombre"], box))
        return 4
    pasos = [p for p in a.pasos.split(",") if p]
    if "reload" in pasos:
        # 0.13.31 (p-231e8eeb51): confirmed as `lookout recarga` confirms it, by the new transcript row. wait-output
        # matched an older «Reloaded:» already on screen, and a full screen gave false «sin confirmar».
        import recarga
        estado, donde = recarga.teclea(pane, entry["session_id"], ENTREGA_RELOAD_ESPERA)
        if estado == "ok":
            print("reload: ok (vi «Reloaded:» en %s)" % donde.split(" (")[0])
        elif estado == "no-tecleado":
            print("reload: NO: herdr no tecleó /reload-plugins. Lee su pane antes de repetirlo.")
        else:
            print("reload: sin confirmar: no veo «Reloaded:» nuevo en %s en %d s. Lee su pane antes de repetirlo." % (
                donde, ENTREGA_RELOAD_ESPERA))
    if "rename" in pasos:
        # 0.13.1: the alta may have renamed it already; a session that carries the name gets no second /rename
        if (live.get("terminal_title_stripped") or "") != entry["nombre"]:
            herdr_cli.run(["agent", "prompt", pane, "/rename " + entry["nombre"]])
        # 0.13.1 (codex round 3): a name herdr refused is not recorded nor reported as done
        fallos = []
        if herdr_cli.run(["agent", "rename", pane, entry["nombre"]])[0] == 0:
            entry["herdr_name"] = entry["nombre"]
            entry.pop("renombre_parcial", None)  # 0.13.5: the agent's own retry stops here (adversary r3)
        else:
            fallos.append("agente")
        if herdr_cli.run(["pane", "rename", pane, "lookout: " + entry["nombre"]])[0] != 0:
            fallos.append("pane")
        # The tab is what the user sees. herdr's default label (the tab number) names nothing: put the agent's name
        # there. A label the user chose, or a tab shared with other panes, is never touched.
        tab = herdr_cli.tab_get(live.get("tab_id") or entry.get("tab_id", ""))
        if tab and (tab.get("pane_count") or 1) == 1 and not herdr_cli.own_label(tab):
            if herdr_cli.run(["tab", "rename", live.get("tab_id") or entry["tab_id"], entry["nombre"]])[0] == 0:
                entry["pestana"] = entry["nombre"]
            else:
                fallos.append("pestaña")
        print("rename: %s (sesión, agente de herdr y pane; pestaña «%s»)%s" % (
            entry["nombre"], entry.get("pestana") or "-",
            "; A MEDIAS: herdr no renombró " + ", ".join(fallos) if fallos else ""))
    if "nota" in pasos and "rename" in pasos:
        # Fase 9 F3: the note is typed only once the /rename left the box. Typed while the /rename was still there, the
        # note arrived glued to it as <pasted_content> (claude-vzert, 2026-10-06). B2 (0.12.2): confirmed by the box,
        # not by a UserPromptSubmit: the built-in /rename never fires one, and waiting for it cost 30 s per agent (6 of
        # 6 deliveries in 3-tier-memory, 2026-10-15).
        box = caja_libre(pane, RENAME_ESPERA)
        if box not in ("vacia", "sugerencia"):
            reg["agents"][entry["session_id"]] = entry
            registry.save(pid, reg)
            print("NO ENTREGADO (nota): tras el /rename la caja de %s sigue con %s después de %ds. No escribo la "
                  "nota encima; mira su pantalla y repite con `--pasos nota`." % (entry["nombre"], box, RENAME_ESPERA))
            return 4
    if "nota" in pasos:
        try:
            offset = os.path.getsize(lookout_state.events_path(pid))
        except OSError:
            offset = 0
        nota = render_nota(pid, entry)
        herdr_cli.run(["agent", "prompt", pane, nota])
        # a late /rename event must not confirm the hooks for the note. Not matched by text: a multi-line note may
        # reach the hook wrapped in <pasted_content>.
        sid = entry["session_id"]
        ok = deliver.wait_event(pid, offset, a.timeout, lambda ev: (
            ev.get("session_id") == sid and ev.get("event") == "working"
            and not (ev.get("prompt") or "").lstrip().startswith("/rename")))
        entry["hooks"] = "ok" if ok else "sin-hooks"
        print("nota: entregada; hooks %s" % ("confirmados (UserPromptSubmit)" if ok else
                                            "SIN CONFIRMAR: no llegó su UserPromptSubmit en %ds" % a.timeout))
    reg["agents"][entry["session_id"]] = entry
    registry.save(pid, reg)
    return 0


def cmd_resumen(a):
    pid, _ = project(a.proyecto)
    print(digest.render(pid, mark=not a.no_marcar, todo=a.todo))


def cmd_reenvia(a):
    """0.13.39: the whole text of a message of the supervisor's that another session held and then dropped."""
    pid, _ = project(a.proyecto)
    import retenido
    m = retenido.mensaje(pid, a.msg_id)
    if m is None:
        sys.exit("no tengo un mensaje con msg_id %s en el registro del supervisor de %s" % (a.msg_id, pid))
    print(m)


def cmd_espera(a):
    pid, _ = project(a.proyecto)
    import wait_event
    owner = {"claude_pid": int(os.environ.get("CLAUDE_PID", "0") or 0), "session_id": os.environ.get("CLAUDE_CODE_SESSION_ID", "")}
    rc = wait_event.wait(lookout_state.events_path(pid), digest.get_cursor(pid), digest.WAKE_TYPES,
                         a.timeout, digest.pidfile(pid), digest.cursor_path(pid), owner if owner["claude_pid"] else None,
                         revisa=pid, hint=False, ventana=digest.ventana_s(), linea=False)
    if rc == 0:
        # The wake carries the digest and marks it handled. A supervisor that relaunched its waiter without running
        # `resumen` got the same old event again at once, took the waiter for broken and stopped launching it
        # (claude-vzert, 2026-10-06): nothing it must remember to run between two waiters.
        print("Resumen (ya marcado como atendido; no hace falta `lookout resumen`):")
        print(digest.render(pid, mark=True, por_waiter=True))
        digest.marca_despertar(pid, owner["session_id"])  # B1: its notification is on its way; the Stop hook knows
    return rc


def cmd_retomar(a):
    """Rewrite supervisor.md and print its «Como retomar» (manual relief of the supervisor, Fase 4)."""
    pid, _ = project(a.proyecto)
    md = supervisor_md.write(pid)
    # The relief needs the user (/exit or /clear + paste): a line in the chat got lost on claude-vzert (2026-10-05).
    herdr_cli.notifica(pid, "relevo-supervisor", "Supervisor: necesito que me reinicies",
                       "Su contexto llegó al presupuesto. Abre la pestaña del supervisor: /exit o /clear y pega su "
                       "«Como retomar». Mientras tanto sigue vigilando.")
    print("Estado escrito en %s. Dale al usuario este bloque tal cual y pídele /exit (o /clear) y pegarlo en la sesión nueva."
          " Sigue supervisando (y relanzando tu waiter) hasta que el relevo tome el candado:" % md)
    print(supervisor_md.retomar_block(pid))
    return 0


def cmd_suelta(a):
    pid, _ = project(a.proyecto)
    me = lock.me()
    if not lock.release(pid, me["session_id"]):
        print("No suelto nada: el candado no es de esta sesión.")
        return 3
    for sid in registry.load(pid).get("agents", {}):
        lookout_state.remove_marker(sid)
    supervisor_md.unmark_supervisor(me["session_id"])
    # No signal to any pid (adversary F4 round 2: pid reuse): with the lock gone the waiter's watchdog sees its
    # session no longer supervises and exits by itself within 10 s.
    w = digest.waiter_alive(pid)
    extra = ", el waiter se cierra solo en ≤10 s" if w else ""
    print("Candado suelto, marcadores borrados%s." % extra)
    return 0


def nota_for(pid):
    return lambda nombre: render_nota(pid, {"nombre": nombre})


def cmd_pendientes(a):
    pid, common = project(a.proyecto)
    if a.match:
        items = pendientes.parse(lote.pendientes_file(common))
        found = pendientes.match(items, a.match)
        for it in found:
            print(pendientes.one_line(it))
        if not found:
            print("(ningún pendiente abierto menciona: %s)" % ", ".join(a.match))
        return 0
    if a.worktree or a.en_main:
        # Fase 9 G: a worktree only when the user asks for it (and back to the main checkout on their word)
        lote.pide_worktree(pid, a.worktree or (), a.en_main or ())
        by_id = {it["id"]: it for it in pendientes.parse(lote.pendientes_file(common))}
        for i in a.worktree or ():
            if i in by_id and lote.solo_lectura(by_id[i]):
                print("%s es de lectura (%s): corre en el checkout principal sin edición; el worktree no aplica."
                      % (i, by_id[i]["tipo"]))
    if a.reintenta:
        reg = registry.load(pid)
        for e in reg.get("agents", {}).values():
            if e.get("tarea") in a.reintenta and e.get("tarea_estado") == "fallida":
                e["reintentar"] = True
        registry.save(pid, reg)
    prop = lote.propone(pid, common, a.tope, a.rehacer)
    print(lote.render_propuesta(prop))
    aviso = modo.aviso_lanzar(pid)  # 0.13.33
    if aviso:
        print(aviso)
    return 0


def cmd_lanza(a):
    pid, common = project(a.proyecto)
    lk = lock.read(pid) or {}
    if (lk.get("supervisor") or {}).get("session_id") != lock.me()["session_id"]:
        print("No lanzo nada: el candado de %s no es de esta sesión (corre `lookout inicia` antes)." % pid)
        return 3
    res = lote.lanza(pid, common, a.ids, nota_for(pid), a.modelo, a.confirmar, a.tope,
                     log=lambda m: print("  " + m), bypass=a.bypass)
    bad = 0
    for pend, ok, msg in res:
        print("%s %s: %s" % ("OK" if ok else "FALLO", pend, msg))
        bad += not ok
    return 0 if not bad else 4


def cmd_libera(a):
    pid, common = project(a.proyecto)
    reg = registry.load(pid)
    e = registry.find(reg, a.agente)
    if not e or not e.get("tarea"):
        sys.exit("agente %r sin tarea registrada" % a.agente)
    ok, lines = lote.revisa_alcance(pid, e, a.fuera, a.usuario_confirmo)
    if lines:
        print("\n".join(lines))
    if not ok:
        return 5
    if a.fuera.strip().lower() != "ninguno":
        reg = registry.load(pid)
        reg["agents"][e["session_id"]]["fuera_de_tarea"] = a.fuera.strip()
        registry.save(pid, reg)
    estado = "fallida" if a.fallida else "terminada"
    with lote.project_mutex(pid):
        lote.set_estado(pid, e["session_id"], estado)
    if lote.puerto_de(e):
        import ports
        ports.libera(lote.puerto_de(e))  # Fase 6: its dev-server port goes back to the pool
    print("%s: tarea %s marcada %s; su hueco queda libre." % (e["nombre"], e["tarea"], estado))
    # Fase 9 E4: the exact close command, not "F3"
    print("Para cerrar el pendiente (con el sí del usuario en una decisión): `lookout cierra %s %s --nota \"<qué quedó "
          "hecho y cómo se verificó>\" --usuario-confirmo <id>`%s." % (
              pid, e["nombre"], " (si no hizo falta push: `--sin-push \"<razón>\"`; si se abandona: `--estado abandoned`)"))
    if a.fallida and e.get("sin_worktree") and not lote.solo_lectura(e):
        print("Sus cambios a medias siguen en el checkout principal: pásale al usuario `git -C %s status --short` y su "
              "reporte. %s no vuelve a proponerse hasta que el usuario decida qué hacer con ellos y corras `lookout "
              "pendientes %s --reintenta %s`." % (e.get("worktree"), e["tarea"], pid, e["tarea"]))
    limpieza = plan_limpieza(e)
    if limpieza:
        print(limpieza)
    print("")
    print(lote.render_propuesta(lote.propone(pid, common)))
    return 0


def plan_limpieza(e):
    """Fase 9 F6: after `libera`, the exact cleanup of the agent's worktree and branch, for the USER to run when the
    pendiente is closed (claude-vzert: a batch left 3 `-wt-` folders and 3 `lookout/*` branches nobody knew how to
    remove). lookout never removes them itself: deleting is the user's (3.12)."""
    wt = e.get("worktree") or ""
    if e.get("sin_worktree") or not wt or not os.path.isdir(wt):
        return ""
    root = wt.rsplit("-wt-", 1)[0]
    rama = e.get("branch") or ""
    out = ["Limpieza, para el usuario cuando el pendiente esté cerrado y la sesión de %s terminada (no la corras tú; "
           "pásasela en un bloque de código):" % e["nombre"],
           "  ! git -C %s worktree remove %s" % (root, wt)]
    if rama:
        out.append("  ! git -C %s branch -d %s" % (root, rama))
        out.append("  (`-d`, no `-D`: git se niega a borrar una rama sin integrar; si se niega, la rama tiene trabajo "
                   "que no está en main ni en origin: pregúntale al usuario antes de nada)")
    out.append("  `worktree remove` se niega si quedan cambios sin commit: entonces no lo fuerces, avisa.")
    return "\n".join(out)


CITA = re.compile(r"«([^«»\n]+)»|`([^`\n]+)`|\"([^\"\n]+)\"|“([^“”\n]+)”")


def visto_por_usuario(d):
    """The texts the user saw whole: their own answer, and every quoted span of the modal's question."""
    out = {str(d.get("respuesta_usuario") or "").strip()}
    for m in CITA.finditer(str(d.get("pregunta") or "")):
        out.add(next(g for g in m.groups() if g is not None).strip())
    return out - {""}


def texto_del_usuario(pid, e, did, texto):
    """0.13.7 (p-5ef58b9041): what the user decided, typed into the agent's pane by the supervisor, so the user never has
    to find the agent (a goalspec spec waiting for «aprobado» in the agent's own pane, 3-tier-memory 2026-10-16; a
    `! comando` the agent asked the user to run). Only with decision `did` answered YES by the user, about this agent,
    and with `texto` written in that decision's question or in the user's answer: the supervisor never types what the
    user did not see. Returns (key, text to type, None) or (None, None, why not)."""
    d = decisiones.respondida(pid, did)
    if not d:
        return None, None, ("hace falta --usuario-confirmo dN de una decisión que el usuario contestó con sí "
                            "(ábrela con `lookout decision … --abre … --agentes <agente> --si-es \"<etiqueta del sí>\"` y tu hook la cierra "
                            "con lo que elija en tu modal); %s no lo es." % (did or "sin dN"))
    if e["nombre"] not in (d.get("agentes") or []):
        return None, None, "la decisión %s no es sobre %s (ábrela con --agentes %s)." % (did, e["nombre"], e["nombre"])
    if not d.get("respuesta_usuario"):
        return None, None, ("%s no tiene respuesta del usuario anotada por el modal o el chat: pregúntaselo en el "
                            "modal antes de teclear nada." % did)
    # Only what the hooks wrote down: the modal's question and the user's literal answer (adversary r1: the --abre
    # text and the --respuesta of --cierra are the supervisor's own words). And the WHOLE text, spaces included: the
    # user's entire answer, or a quoted span of the question (adversary r2: a whitespace-free substring let through
    # «! rm -rf /» out of an approved «! rm -rf /tmp/x/old», and a moved space that splits an argument).
    texto = (texto or "").strip()
    if not texto or "\n" in texto or texto not in visto_por_usuario(d):
        return None, None, ("«%s» no es la respuesta entera del usuario en %s ni va completo entre «», `` o \"\" en la "
                            "pregunta del modal: pon ahí el texto exacto que se teclea (una línea), o que lo escriba él "
                            "en Other." % (texto, did))
    if not deliver.es_comando(texto) and not texto.lstrip().startswith("/"):
        texto = "%s (%s)" % (texto.strip(), did)  # the agent sees whose decision it is
        # 0.13.44: and what the user approved, in one line: d288 (3-tier-memory, 2026-10-20) approved a plan with «el
        # push va aparte», the agent only got «aprobado (d288)» and wrote «push y PR pedidos» in its goal-spec
        pregunta = " ".join(str(d.get("pregunta") or "").split())
        if pregunta:
            texto += " — lo que aprobó el usuario: «%s»" % pregunta
    if d.get("tipo") == "negado":  # 0.13.46: a refused Bash, typed as «! comando» (teclea.py)
        clave, motivo = teclea.clave(pid, e, d, texto)
        return (None, None, motivo) if motivo else (clave, texto, None)
    return "usuario:" + did, texto, None


def cmd_envia(a):
    pid, _ = project(a.proyecto)
    uc = getattr(a, "usuario_confirmo", "") or ""
    e = registry.find(registry.load(pid), a.agente)
    if not e:
        sys.exit("agente %r no registrado" % a.agente)
    if a.tarea:
        if not e.get("tarea"):
            sys.exit("agente %r sin tarea registrada" % a.agente)
        clave, texto = "tarea:" + e["tarea"], lote.TRIGGER.format(id=e["tarea"])
    elif uc or any(deliver.es_comando(l) for l in (a.texto or "").splitlines()):
        clave, texto, motivo = texto_del_usuario(pid, e, uc, a.texto or "")
        if motivo:
            print("NO TECLEADO: " + motivo)
            return 5
    elif a.clave and a.texto:
        clave, texto = a.clave, a.texto
    else:
        sys.exit("usa --tarea, --usuario-confirmo dN y --texto, o --clave y --texto")
    code, msg = deliver.deliver(pid, e, clave, texto, a.confirmar)
    if code == 0 and not a.tarea:
        # an answer typed into the agent's box is a decision too: log it like a SendMessage (Fase 4, relief)
        supervisor_md.log(pid, dict({"tipo": "respuesta", "to": e["nombre"], "via": "envia",
                                     "texto": supervisor_md.one_line(texto, 600)},
                                    **({"decision": uc} if uc else {})))
        supervisor_md.write(pid)
    if code == 0 and a.tarea and e.get("tarea_estado") in ("lanzando", "sin-confirmar"):
        lote.set_estado(pid, e["session_id"], "trabajando", hooks="ok")
    print(msg)
    return code


def agent_entry(pid, name):
    e = registry.find(registry.load(pid), name)
    if not e:
        sys.exit("agente %r no registrado" % name)
    return e


def cmd_gobierno(a):
    pid, _ = project(a.proyecto)
    e = agent_entry(pid, a.agente)
    if a.usuario_amplia:
        d = decisiones.respondida(pid, a.decision or "")
        if not d:
            print("NO: --usuario-amplia necesita --decision <id> de una decisión que el usuario respondió con un sí "
                  "(`lookout decision %s --abre … --agentes <agente> --si-es \"<etiqueta del sí>\"` y pregúntale en tu modal: "
                  "tu hook la cierra con lo que elija)." % pid)
            return 5
        gobierno.amplia(pid, e, a.usuario_amplia)
        print("Decisión %s: %s → %s" % (d["id"], d["texto"], d.get("respuesta", "")))
        print("Límite de rondas de %s: %d (lo aprobó el usuario)." % (e.get("tarea") or e["nombre"], a.usuario_amplia))
        print(gobierno.render(gobierno.estado(pid, e)))
        return 0  # recording the user's yes succeeded; ask --para push/ronda separately for a decision
    st = gobierno.estado(pid, e)
    print(gobierno.render(st))
    ok, code, text = (gobierno.decide_ronda if a.para == "ronda" else gobierno.decide_push)(st)
    print("")
    print("%s — %s" % (code, text))
    return 0 if ok else 5


def cmd_publica(a):
    pid, common = project(a.proyecto)
    if getattr(a, "modo", ""):
        with lote.project_mutex(pid):
            publica.pon_modo(pid, a.modo)
        print("Modo de publicación de %s: %s." % (pid, a.modo))
        print("Un agente publica con push a su rama y un PR que fusiona el usuario (o tú, con su sí: --fusiona)."
              if a.modo == "pr" else "Un agente publica con push directo a la rama principal de origin.")
        return 0
    if getattr(a, "fusiona", 0):
        with lote.project_mutex(pid):
            ok, code, lines = publica.fusiona(pid, a.fusiona, a.decision, getattr(a, "fuera_de_orden", False))
        print("\n".join(lines))
        print("")
        print(code)
        return 0 if ok else 5
    if a.cola or not a.agente:
        print(publica.render_cola(pid))
        return 0
    e = agent_entry(pid, a.agente)
    with lote.project_mutex(pid):
        if a.hecho:
            wt = None
            if getattr(a, "worktree", ""):  # 0.13.41: the tree of a PR opened outside lookout (registra_pr)
                wt, _, why = publica.valida_worktree(common, a.worktree)
                if why:
                    print("NO: --worktree: %s. Pregúntale al agente la ruta de su worktree." % why)
                    return 5
            ok, lines = publica.hecho(pid, e, pr=getattr(a, "pr", 0) or None, worktree=wt)
            print("\n".join(lines))
            return 0 if ok else 5
        if a.retira:
            print("Retirada de la cola." if publica.retira(pid, e) else "No estaba en la cola.")
            return 0
        wt = None
        if getattr(a, "worktree", ""):
            top, rama, why = publica.valida_worktree(common, a.worktree)
            if why:
                print("NO: --worktree: %s. Pregúntale al agente la ruta de su worktree." % why)
                print("")
                print("WORKTREE-AJENO")
                return 5
            wt = (top, rama)
        ok, code, lines = publica.pide(pid, e, gobierno.estado(pid, e), worktree=wt, decision=getattr(a, "decision", "") or "")
    print("\n".join(lines))
    print("")
    print("%s" % code)
    if ok:
        root = lote.repo_root(common)
        est, _ = publica.regla_estado(root)
        print("")
        print("Siguiente: `lookout decision %s --abre \"<qué decide>\" --agentes %s --si-es \"<etiqueta del sí>\"` y pásale al usuario este push "
              "para que lo apruebe en un AskUserQuestion (junto con sus otras decisiones pendientes, nunca en prosa), "
              "con el resumen de arriba." % (pid, e["nombre"]))
        if publica.modo(pid) == "pr":
            me = publica.entry_of(publica.load(pid), e["session_id"]) or {}
            print("Modo PR: tras el push, el agente abre el PR (`gh pr create --base %s --head %s --fill`) y te da su "
                  "número; entonces `lookout publica %s %s --hecho --pr <N>`. Fusionarlo es otra decisión del usuario "
                  "(`lookout publica %s --fusiona <N> --decision <id>`)." % (
                      me.get("rama_base") or "main", me.get("rama_remota") or "<rama>", pid, e["nombre"], pid))
        if est == "aplicada":
            print("Regla temporal de push: APLICADA. Con el sí del usuario, dile al agente que corra la orden exacta, sola.")
        else:
            print("Regla temporal de push: %s. Con el sí del usuario NO le digas al agente que haga push: dale al "
                  "usuario el texto de `lookout regla-push %s` y espera a que diga que la aplicó; compruébalo con "
                  "`lookout regla-push %s --estado`. Solo con APLICADA el agente corre el push." % (est.upper(), pid, pid))
    return 0 if ok else 5


def cmd_permisos(a):
    rules = permisos.load_rules()
    estado = "ACTIVAS" if rules["activo"] else "NO ACTIVAS (todo permiso va al usuario)"
    print("Reglas de permisos de los ejecutores: %s" % estado)
    print("Plantilla del plugin: %s" % permisos.TEMPLATE)
    print("Archivo del usuario: %s" % permisos.user_rules_path())
    print("Las activa el USUARIO creando ese archivo con `activo = true` (yo no lo escribo). Solo aprueban en modo")
    print("manual, una vez por llamada. En auto mode las reglas no aprueban nada y decide el clasificador de Claude Code.")
    print("Aparte (0.13.12): el sí del usuario en tu modal a un diálogo de Bash lo pulsa `lookout aprueba`, una vez.")
    print("Diálogo forzado en auto mode: %s. Con `dialogo_forzado = true` en ese archivo, push, merge, publicar, gh repo"
          % ("ENCENDIDO" if rules.get("dialogo_forzado") else "apagado (por omisión)"))
    print("delete/archive, gh api con escritura y borrados fuera del worktree piden diálogo (leído del texto del comando:")
    print("cubre las formas usuales, no las que el texto no muestra).")
    print("Bash permitido: " + ", ".join((rules.get("bash") or {}).get("comandos") or []))
    return 0 if rules["activo"] else 5


def cmd_regla_push(a):
    pid, common = project(a.proyecto)
    root = lote.repo_root(common)
    if a.estado:
        est, falta = publica.regla_estado(root)
        print("Regla temporal de push en %s: %s" % (publica.settings_path(root), est.upper()))
        if falta and est != "ausente":
            print("Faltan: " + ", ".join(falta))
        return 0 if est == "aplicada" else 5
    print(publica.regla_texto(root))
    return 0


def cmd_descarta(a):
    """Fase 9 C1: close, through the journal, a pendiente that never had an agent; with the user's yes."""
    pid, common = project(a.proyecto)
    d = decisiones.respondida(pid, a.usuario_confirmo or "")
    if not d:
        print("NO: --usuario-confirmo necesita el id de una decisión que el usuario respondió con un sí (p.ej. d3); "
              "%r no lo es. Ábrela con `lookout decision … --abre … --si-es \"<etiqueta del sí>\"` y pregúntale en tu "
              "modal: tu hook la cierra con lo que elija." % a.usuario_confirmo)
        return 5
    lk = lookout_state.read_json(os.path.join(lookout_state.project_dir(pid), "lock.json")) or {}
    sesion = (lk.get("supervisor") or {}).get("session_id") or "lookout-descarta"
    ok, lines = cierre.descarta(pid, common, a.pendiente, a.estado,
                                a.nota + " — confirmó el usuario: %s (%s)" % (d["id"], d.get("respuesta", "")),
                                True, sesion)
    print("\n".join(lines))
    return 0 if ok else 5


def cmd_cierra(a):
    pid, common = project(a.proyecto)
    e = agent_entry(pid, a.agente)
    d = decisiones.respondida(pid, a.usuario_confirmo or "")
    if a.usuario_confirmo and not d:
        print("NO: --usuario-confirmo necesita el id de una decisión que el usuario respondió con un sí (p.ej. d3); "
              "%r no lo es. Ábrela con `lookout decision … --abre … --si-es \"<etiqueta del sí>\"` y pregúntale en tu "
              "modal: tu hook la cierra con lo que elija." % a.usuario_confirmo)
        return 5
    ok, lines = cierre.cierra(pid, common, e, gobierno.estado(pid, e), a.estado,
                              a.nota + (" — confirmó el usuario: %s (%s)" % (d["id"], d.get("respuesta", "")) if d else ""),
                              bool(d), a.sin_push)
    print("\n".join(lines))
    if ok:
        print("")
        print(lote.render_propuesta(lote.propone(pid, common)))
    return 0 if ok else 5


def cmd_corrige(a):
    import heuristicas
    pid, _ = project(a.proyecto)
    e = agent_entry(pid, a.agente)
    code, text = heuristicas.corrige(pid, e, a.resumen, a.firma, a.reporte)
    if code == 0:
        print("Corrección registrada. Mándasela TAL CUAL por SendMessage a %s (to = la dirección de su último mensaje, o "
              "%s), y termina tu turno:" % (e["nombre"], sesiones.to_texto(e)))
    print(text)
    return code


def cmd_puerto(a):
    import ports
    pid, common = project(a.proyecto)
    e = agent_entry(pid, a.agente)
    if lote.solo_lectura(e) and e.get("lanzado_por") == "lookout":
        print("%s tiene una tarea de lectura: no levanta servidores." % e["nombre"])
        return 5
    wt = lote.puerto_de(e) or e.get("worktree") or e.get("cwd")
    if not wt:
        print("%s no tiene carpeta registrada." % e["nombre"])
        return 5
    root = lote.repo_root(common)
    if not e.get("clave_puerto") and os.path.realpath(wt) == os.path.realpath(root):
        # Fase 9 G: a session discovered on the main checkout shares the folder with others: its own key
        wt = root.rstrip("/") + "-tab-" + e["nombre"]
        reg = registry.load(pid)
        reg["agents"][e["session_id"]]["clave_puerto"] = wt
        registry.save(pid, reg)
        if not any(not o.get("clave_puerto") and os.path.realpath(o.get("worktree") or o.get("cwd") or "") ==
                   os.path.realpath(root) for o in reg["agents"].values()):
            ports.libera(root)  # the port it had under the shared folder (before 0.11.0), once nobody else holds it
    port = ports.asigna(wt)
    if not port:
        print("No hay puerto libre en %d-%d." % (ports.base(), ports.base() + ports.span() - 1))
        return 4
    print("%s (%s): puerto %d. Si no lo lanzó lookout (no tiene $PORT), mándale por SendMessage (%s): \"Para tu "
          "servidor de desarrollo usa el puerto %d (PORT=%d); otros agentes levantan los suyos a la vez.\"" % (
              e["nombre"], wt, port, sesiones.to_texto(e), port, port))  # 0.13.35 (p-561f1a2173): its real to
    return 0


def cmd_relevo(a):
    retomar = ""
    if a.retomar:  # 0.13.17: a path; the «Como retomar» text itself gave a FileNotFoundError traceback (3-tier)
        try:
            with open(a.retomar, encoding="utf-8") as fh:
                retomar = fh.read()
        except (OSError, UnicodeDecodeError) as ex:
            print("No releva nada: --retomar espera la ruta de un archivo con su «Como retomar», y «%s» no se "
                  "puede leer (%s). Escribe el bloque en un archivo y pasa su ruta." % (
                      a.retomar, ex.strerror if isinstance(ex, OSError) and ex.strerror else type(ex).__name__))
            return 2
    pid, _ = project(a.proyecto)
    lk = lock.read(pid) or {}
    if (lk.get("supervisor") or {}).get("session_id") != lock.me()["session_id"]:
        print("No releva nada: el candado de %s no es de esta sesión." % pid)
        return 3
    e = agent_entry(pid, a.agente)
    ok, msg = relevo.relevo(pid, e, nota_for(pid), retomar, a.modelo, a.confirmar, log=lambda m: print("  " + m),
                            shells=a.shells or "", goalspec=a.goalspec)
    print(msg)
    return 0 if ok else 4


def cmd_retoma(a):
    """0.13.20: an agent whose session ended without anyone asking starts again with its context (retoma.py)."""
    pid, _ = project(a.proyecto)
    lk = lock.read(pid) or {}
    if (lk.get("supervisor") or {}).get("session_id") != lock.me()["session_id"]:
        print("No retoma nada: el candado de %s no es de esta sesión." % pid)
        return 3
    e = agent_entry(pid, a.agente)
    ok, msg = retoma.retoma(pid, e, a.confirmar, log=lambda m: print("  " + m))
    print(msg)
    return 0 if ok else 4


def cmd_recarga(a):
    """0.13.8: /reload-plugins in an agent whose hooks are older than the installed plugins (recarga.py)."""
    pid, _ = project(a.proyecto)
    lk = lock.read(pid) or {}
    if (lk.get("supervisor") or {}).get("session_id") != lock.me()["session_id"]:
        print("No recargo nada: el candado de %s no es de esta sesión." % pid)
        return 3
    import recarga
    ok, msg = recarga.recarga(pid, agent_entry(pid, a.agente))
    print(msg)
    return 0 if ok else 4


def cmd_cierra_pestana(a):
    """0.13.0 (Fase 2): close the tab of a finished agent after two signals and the guards (retiro.py)."""
    pid, _ = project(a.proyecto)
    lk = lock.read(pid) or {}
    if (lk.get("supervisor") or {}).get("session_id") != lock.me()["session_id"]:
        print("No cierro nada: el candado de %s no es de esta sesión." % pid)
        return 3
    e = agent_entry(pid, a.agente)
    if a.revisa:
        frenos = retiro.revisa(pid, e, a.motivo or "", a.usuario_confirmo or "", a.shells or "")
        print("Se puede cerrar." if not frenos else "No se puede cerrar: " + "; ".join(frenos) + ".")
        return 0 if not frenos else 4
    ok, msg = retiro.cierra(pid, e, a.motivo or "", confirmo=a.usuario_confirmo or "", shells=a.shells or "")
    print(msg)
    return 0 if ok else 4


def cmd_aprueba(a):
    """0.13.12: relay the user's yes to one permission dialog of an agent (aprueba.py)."""
    pid, _ = project(a.proyecto)
    lk = lock.read(pid) or {}
    if (lk.get("supervisor") or {}).get("session_id") != lock.me()["session_id"]:
        print("No pulso nada: el candado de %s no es de esta sesión." % pid)
        return 3
    ok, msg = aprueba.aprueba(pid, agent_entry(pid, a.agente), a.decision or "")
    print(msg)
    return 0 if ok else 4


def cmd_decision(a):
    pid, _ = project(a.proyecto)
    if a.abre and getattr(a, "permiso", False):
        agentes = [x for x in (a.agentes or "").split(",") if x]
        if len(agentes) != 1 or a.cierre or any((getattr(a, "shells_parar", ""), getattr(a, "shells_dejar", ""))):
            print("NO ABIERTA: una decisión --permiso es de un solo agente (--agentes <agente>), con --si-es y sin "
                  "--cierre ni --shells-*.")
            return 5
        ok, it = aprueba.abre(pid, agent_entry(pid, agentes[0]), a.abre, a.si_es or "")
        if not ok:
            print("NO ABIERTA: " + it)
            return 5
        supervisor_md.write(pid)
        print("Decisión %s abierta (aviso de herdr mostrado). Pon «(%s)» al final de su pregunta, con el comando entero "
              "que pide %s entre «», y la opción «%s» tal cual en el modal: tu hook la cierra con lo que elija el usuario. Si "
              "dice sí, corre `lookout aprueba %s %s --decision %s`. El comando, tal cual y entre «» en la pregunta:\n«%s»"
              % (it["id"], it["id"], agentes[0], it["si_es"], pid, agentes[0], it["id"], it["permiso"]["comando"]))
        destino = aprueba.explica_destino(it["permiso"].get("destino"))
        if destino:
            print(destino)
        return 0
    if a.abre and getattr(a, "negado", False):
        agentes = [x for x in (a.agentes or "").split(",") if x]
        if len(agentes) != 1 or a.cierre or getattr(a, "permiso", False) or any(
                (getattr(a, "shells_parar", ""), getattr(a, "shells_dejar", ""))):
            print("NO ABIERTA: una decisión --negado es de un solo agente (--agentes <agente>), con --si-es y sin "
                  "--cierre, --permiso ni --shells-*.")
            return 5
        ok, it = teclea.abre(pid, agent_entry(pid, agentes[0]), a.abre, a.si_es or "", getattr(a, "siempre_es", "") or "")
        if not ok:
            print("NO ABIERTA: " + it)
            return 5
        supervisor_md.write(pid)
        tecla = teclea.linea(it["negado"]["comando"])
        print("Decisión %s abierta (aviso de herdr mostrado). Pon «(%s)» al final de su pregunta, con lo que voy a teclear "
              "entre «», y la opción «%s» tal cual en el modal%s, sin marcar ninguna como recomendada: tu hook la cierra "
              "con lo que elija el usuario. Si dice sí, corre tal cual `lookout envia %s %s --usuario-confirmo %s --texto %s`. "
              "Lo que se teclea, tal cual y entre «» en la pregunta:\n«%s»"
              % (it["id"], it["id"], it["si_es"],
                 (" y «%s» para «siempre para este comando»" % it["siempre_es"]) if it.get("siempre_es") else "",
                 pid, agentes[0], it["id"], shlex.quote(tecla), tecla))  # codex r4: quoted for the supervisor's shell
        return 0
    if a.abre and getattr(a, "sin_revisor", False):
        agentes = [x for x in (a.agentes or "").split(",") if x]
        if len(agentes) != 1 or a.cierre or getattr(a, "permiso", False) or any(
                (getattr(a, "shells_parar", ""), getattr(a, "shells_dejar", ""))):
            print("NO ABIERTA: una decisión --sin-revisor es de un solo agente (--agentes <agente>), con --si-es y sin "
                  "--cierre, --permiso ni --shells-*.")
            return 5
        e = agent_entry(pid, agentes[0])
        ok, it = publica.abre_sin_revisor(pid, e, a.abre, a.si_es or "", gobierno.estado(pid, e))
        if not ok:
            print("NO ABIERTA: " + it + ".")
            return 5
        supervisor_md.write(pid)
        acepta = it["sin_revisor"]["veredicto"]
        print("Decisión %s abierta (aviso de herdr mostrado). Pon «(%s)» al final de su pregunta y la opción «%s» tal cual "
              "en el modal, sin marcarla como recomendada: tu hook la cierra con lo que elija el usuario. La pregunta dice "
              "en palabras simples qué no se revisó otra vez (%s). Si dice sí: `lookout publica %s %s --decision %s` "
              "(verifica base, versión y rutas como siempre; vale para una publicación y solo con ese veredicto)."
              % (it["id"], it["id"], it["si_es"], acepta or "no hay ningún veredicto del adversario", pid, agentes[0],
                 it["id"]))
        return 0
    if a.abre:
        agentes = [x for x in (a.agentes or "").split(",") if x]
        previas = decisiones.tomadas_de(pid, agentes)
        if previas and not a.nueva:
            # Fase 4: a relief (or a forgetful turn) must not ask the user again what is already decided.
            print("NO ABIERTA: ya hay decisiones del usuario sobre %s:" % ", ".join(agentes))
            for d in previas:
                print("- %s: %s → %s: %s" % (d["id"], d["texto"], "SÍ" if d.get("aprueba") else "NO", d.get("respuesta", "")))
            print("Si una de ellas ya responde esto, úsala y no preguntes. Si es otra cosa, repite con --nueva.")
            return 5
        if a.cierre and (not agentes or not a.si_es):
            print("NO ABIERTA: una decisión --cierre necesita --agentes <agente> y --si-es \"<etiqueta de la opción sí>\".")
            return 5
        shells = {"parar": getattr(a, "shells_parar", "") or "", "dejar": getattr(a, "shells_dejar", "") or ""}
        if any(shells.values()):
            if not (agentes and all(v.strip() for v in shells.values())) or a.cierre or a.si_es \
                    or shells["parar"] == shells["dejar"]:
                print("NO ABIERTA: una decisión de trabajo de fondo necesita --agentes <agente>, --shells-parar y "
                      "--shells-dejar con dos etiquetas distintas, y ni --cierre ni --si-es.")
                return 5
        it = decisiones.abre(pid, a.abre, agentes, si_es=a.si_es or "", tipo="cierre" if a.cierre else "",
                             shells=shells if any(shells.values()) else None)
        supervisor_md.write(pid)
        if it.get("opciones"):
            print("Decisión %s abierta (aviso de herdr mostrado). Pon «(%s)» al final de su pregunta y las opciones «%s» y "
                  "«%s» tal cual en el modal, más una de esperar: tu hook anota cuál elige el usuario. Luego repite con "
                  "--shells %s." % (it["id"], it["id"], it["opciones"]["parar"], it["opciones"]["dejar"], it["id"]))
        elif it.get("si_es"):
            print("Decisión %s abierta (aviso de herdr mostrado). Pon «(%s)» al final de su pregunta y la opción «%s» tal "
                  "cual en el modal: tu hook la cierra con lo que elija el usuario (no hace falta --cierra)."
                  % (it["id"], it["id"], it["si_es"]))
        else:  # 0.13.42 (p-687158e30a): this one too asks for the id, like the ones above
            print("Decisión %s abierta (aviso de herdr mostrado). Pon «(%s)» al final de su pregunta. Ciérrala con "
                  "`lookout decision %s --cierra %s --respuesta … --no` cuando el usuario conteste. Si su sí debe "
                  "autorizar algo, ábrela con --si-es \"<etiqueta del sí>\": un sí solo vale si lo anota tu hook."
                  % (it["id"], it["id"], pid, it["id"]))
        return 0
    if a.cierra:
        if a.si == a.no:
            print("NO: di si el usuario aprobó: --si (su respuesta autoriza lo preguntado) o --no (no lo autoriza).")
            return 5
        hecha = next((x for x in decisiones.load(pid)["items"] if x["id"] == a.cierra), None)
        if not hecha:
            print("La decisión %s no existe en %s (`lookout decision %s` lista las pendientes)." % (a.cierra, pid, pid))
            return 5
        if hecha.get("por_hook"):  # 0.13.9: the modal's hook already closed it with the user's own choice; that stands
            print("Decisión %s ya cerrada por tu hook con la elección del usuario («%s»: %s)."
                  % (a.cierra, hecha.get("respuesta_usuario", ""), "sí" if hecha.get("aprueba") else "no"))
            return 0
        if hecha.get("estado") != "abierta":
            # 0.13.21: «No hay una decisión abierta» read as «no existe» (3-tier 2026-10-17, the vigía's test modals)
            print("Decisión %s ya está respondida (%s): «%s». No hay nada que cerrar%s." % (
                a.cierra, supervisor_md.veredicto(hecha), hecha.get("respuesta") or "",
                "; vino de un modal que no nombraba ninguna decisión" if hecha.get("origen") == "hook" else ""))
            return 0
        it = decisiones.cierra(pid, a.cierra, a.respuesta or "", a.si)
        supervisor_md.write(pid)
        print("Decisión %s cerrada." % a.cierra if it else "No hay una decisión abierta %s." % a.cierra)
        return 0 if it else 5
    print(decisiones.render(pid) or "Decisiones del usuario pendientes: ninguna.")
    return 0


def main():
    ap = argparse.ArgumentParser(prog="lookout")
    sub = ap.add_subparsers(dest="cmd", required=True)
    sub.add_parser("quien")
    p = sub.add_parser("inicia"); p.add_argument("proyecto"); p.add_argument("--nombre", default="")
    p = sub.add_parser("entrega"); p.add_argument("proyecto"); p.add_argument("agente")
    p.add_argument("--pasos", default="reload,rename,nota"); p.add_argument("--timeout", type=float, default=30)
    p = sub.add_parser("nota"); p.add_argument("proyecto"); p.add_argument("agente")
    p = sub.add_parser("resumen"); p.add_argument("proyecto"); p.add_argument("--no-marcar", action="store_true")
    p.add_argument("--todo", action="store_true")
    p = sub.add_parser("retomar"); p.add_argument("proyecto")
    p = sub.add_parser("reenvia"); p.add_argument("proyecto"); p.add_argument("msg_id")
    p = sub.add_parser("espera"); p.add_argument("proyecto"); p.add_argument("--timeout", type=float, default=WAITER_TIMEOUT)
    p = sub.add_parser("suelta"); p.add_argument("proyecto")
    p = sub.add_parser("pendientes"); p.add_argument("proyecto"); p.add_argument("--tope", type=int, default=None)
    p.add_argument("--rehacer", action="store_true"); p.add_argument("--match", nargs="+", default=None)
    p.add_argument("--worktree", nargs="+", default=None, metavar="ID", help="el usuario pidió worktree para estos ids")
    p.add_argument("--en-main", nargs="+", default=None, metavar="ID", help="vuelven al checkout principal")
    p.add_argument("--reintenta", nargs="+", default=None, metavar="ID",
                   help="el usuario ya decidió qué hacer con los cambios a medias en main de estas tareas fallidas")
    p = sub.add_parser("lanza"); p.add_argument("proyecto"); p.add_argument("ids", nargs="+")
    p.add_argument("--modelo", default=os.environ.get("LOOKOUT_MODELO")); p.add_argument("--confirmar", type=float, default=30)
    p.add_argument("--tope", type=int, default=None)
    p.add_argument("--bypass", action="store_true",
                   help="0.13.33: el usuario eligió lanzar en bypass, como el supervisor (modo.aviso_lanzar)")
    p = sub.add_parser("libera"); p.add_argument("proyecto"); p.add_argument("agente"); p.add_argument("--fallida", action="store_true")
    p.add_argument("--fuera", default="", metavar="ninguno|TEXTO")
    p.add_argument("--usuario-confirmo", metavar="DECISION_ID", default="")
    p = sub.add_parser("envia"); p.add_argument("proyecto"); p.add_argument("agente")
    p.add_argument("--clave"); p.add_argument("--texto"); p.add_argument("--tarea", action="store_true")
    p.add_argument("--usuario-confirmo", metavar="DECISION_ID", default="",
                   help="dN con el sí del usuario: teclea en su pane lo que el usuario decidió (obligatorio para «! comando»)")
    p.add_argument("--confirmar", type=float, default=30)
    p = sub.add_parser("gobierno"); p.add_argument("proyecto"); p.add_argument("agente")
    p.add_argument("--para", choices=["push", "ronda"], default="push"); p.add_argument("--usuario-amplia", type=int)
    p.add_argument("--decision", default="")
    p = sub.add_parser("publica"); p.add_argument("proyecto"); p.add_argument("agente", nargs="?")
    p.add_argument("--hecho", action="store_true"); p.add_argument("--retira", action="store_true")
    p.add_argument("--cola", action="store_true"); p.add_argument("--worktree", default="")
    p.add_argument("--modo", choices=list(publica.MODOS), default="")
    p.add_argument("--pr", type=int, default=0, help="--hecho en modo PR: el número del PR que abrió el agente")
    p.add_argument("--fusiona", type=int, default=0, metavar="N", help="fusiona el PR N de la cola con el sí del usuario")
    p.add_argument("--decision", default="", help="--fusiona: la decisión dN que el usuario respondió con el sí; con un "
                   "agente: su sí a una decisión --sin-revisor (publicar sin otra revisión del adversario)")
    p.add_argument("--fuera-de-orden", action="store_true", help="--fusiona: un PR que no es el primero en fusionar")
    p = sub.add_parser("regla-push"); p.add_argument("proyecto"); p.add_argument("--estado", action="store_true")
    sub.add_parser("permisos")
    p = sub.add_parser("cierra"); p.add_argument("proyecto"); p.add_argument("agente")
    p.add_argument("--estado", choices=["resolved", "superseded", "abandoned"], default="resolved"); p.add_argument("--nota", required=True)
    p.add_argument("--usuario-confirmo", metavar="DECISION_ID", default=""); p.add_argument("--sin-push", default="")
    p = sub.add_parser("descarta"); p.add_argument("proyecto"); p.add_argument("pendiente")
    p.add_argument("--estado", choices=["abandoned", "superseded"], default="abandoned"); p.add_argument("--nota", required=True)
    p.add_argument("--usuario-confirmo", metavar="DECISION_ID", default="")
    p = sub.add_parser("relevo"); p.add_argument("proyecto"); p.add_argument("agente")
    p.add_argument("--retomar", metavar="ARCHIVO",
                   help="ruta de un archivo con el «Como retomar» que recibe la sesión nueva (no el texto)")
    p.add_argument("--modelo", default=os.environ.get("LOOKOUT_MODELO"))
    p.add_argument("--confirmar", type=float, default=30)
    p.add_argument("--shells", default="", metavar="DECISION_ID",
                   help="id (dN) de la elección del usuario para su trabajo de fondo vivo (parar o dejarlo)")
    p.add_argument("--goalspec", action="store_true",
                   help="la sesión nueva recibe /goalspec:goalspec <disparador>: su «Como retomar» trae trabajo que no es "
                        "solo medir (o dudas)")
    p = sub.add_parser("retoma"); p.add_argument("proyecto"); p.add_argument("agente")
    p.add_argument("--confirmar", type=float, default=30)
    p = sub.add_parser("recarga"); p.add_argument("proyecto"); p.add_argument("agente")
    p = sub.add_parser("cierra-pestana"); p.add_argument("proyecto"); p.add_argument("agente")
    p.add_argument("--motivo", help="cita tal cual de su último turno que dice que terminó (si no dejó «Como retomar»)")
    p.add_argument("--revisa", action="store_true", help="solo dice si se puede cerrar; no toca nada")
    p.add_argument("--usuario-confirmo", help="id (dN) del sí del usuario a cerrarla: lo exige un relevo fallido, y con él se cierra un bloque ambiguo o un turno con una pregunta")
    p.add_argument("--shells", default="", metavar="DECISION_ID",
                   help="id (dN) de la elección del usuario para su trabajo de fondo vivo (parar o dejarlo)")
    p = sub.add_parser("decision"); p.add_argument("proyecto"); p.add_argument("--abre"); p.add_argument("--agentes")
    p.add_argument("--cierra"); p.add_argument("--respuesta"); p.add_argument("--lista", action="store_true")
    p.add_argument("--si", action="store_true"); p.add_argument("--no", action="store_true")
    p.add_argument("--nueva", action="store_true")
    p.add_argument("--si-es", default="", help="etiqueta de la opción del modal que significa sí: tu hook cierra la "
                                              "decisión con lo que elija el usuario")
    p.add_argument("--cierre", action="store_true", help="la decisión es cerrar la pestaña de --agentes (cierra-pestana)")
    p.add_argument("--shells-parar", default="", help="etiqueta de la opción del modal que para su trabajo de fondo al salir")
    p.add_argument("--shells-dejar", default="", help="etiqueta de la opción del modal que lo deja en segundo plano al salir")
    p.add_argument("--negado", action="store_true",
                   help="la decisión es teclear «! comando» en el pane de --agentes: el último Bash que el clasificador le negó")
    p.add_argument("--siempre-es", default="", help="--negado: etiqueta de la opción «sí, y siempre para este comando»")
    p.add_argument("--permiso", action="store_true",
                   help="la decisión es aprobar el permiso que espera --agentes (su petición pendiente, comando entero)")
    p.add_argument("--sin-revisor", action="store_true",
                   help="la decisión es publicar --agentes sin otra revisión del adversario (sin veredicto o break con "
                        "unsafe=0); luego `publica … --decision <id>`")
    p = sub.add_parser("aprueba"); p.add_argument("proyecto"); p.add_argument("agente")
    p.add_argument("--decision", required=True, metavar="DECISION_ID",
                   help="id (dN) del sí del usuario en tu modal a una decisión --permiso de ese agente")
    p = sub.add_parser("corrige"); p.add_argument("proyecto"); p.add_argument("agente")
    p.add_argument("--resumen", required=True); p.add_argument("--firma", default=None)
    p.add_argument("--reporte", default=None)
    p = sub.add_parser("puerto"); p.add_argument("proyecto"); p.add_argument("agente")
    a = ap.parse_args()
    return {"quien": cmd_quien, "inicia": cmd_inicia, "entrega": cmd_entrega, "nota": cmd_nota,
            "resumen": cmd_resumen, "espera": cmd_espera, "suelta": cmd_suelta,
            "pendientes": cmd_pendientes, "lanza": cmd_lanza, "libera": cmd_libera, "descarta": cmd_descarta, "envia": cmd_envia,
            "gobierno": cmd_gobierno, "publica": cmd_publica, "regla-push": cmd_regla_push, "permisos": cmd_permisos, "cierra": cmd_cierra,
